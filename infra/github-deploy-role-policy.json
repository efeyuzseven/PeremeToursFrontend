{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::peremetours-test-890571110014-eu-central-1"
    },
    {
      "Sid": "UploadSiteFilesAndPrerenderedPages",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::peremetours-test-890571110014-eu-central-1/*"
    },
    {
      "Sid": "RemoveStalePrerenderedPages",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::peremetours-test-890571110014-eu-central-1/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::890571110014:distribution/E2CWRTSM9C24S6"
    }
  ]
}
